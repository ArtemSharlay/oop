<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">
    <Properties>
        <Property name="logFile">factory.log</Property>
        <Property name="pattern">%d{HH:mm:ss} %-5level %c - %msg%n</Property>
    </Properties>

    <Appenders>
        <File name="File" fileName="${logFile}" append="true" immediateFlush="true">
            <PatternLayout pattern="${pattern}"/>
        </File>

    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>